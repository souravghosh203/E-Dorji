# Copy to .env and set a private admin password before starting the app.
E_DORJI_ADMIN_NAME=E-Dorji Admin
E_DORJI_ADMIN_EMAIL=admin@example.com
E_DORJI_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional password reset delivery endpoint. The server posts {to, template, code, expiresInMinutes}.
E_DORJI_MAILER_URL=
E_DORJI_MAILER_TOKEN=

PORT=5173
